FLEET_ENVIRONMENT=development
FLEET_LOG_LEVEL=INFO

# Used by docker compose for the database container and the API's connection URL.
POSTGRES_PASSWORD=
FLEET_DATABASE_URL=postgresql+asyncpg://fleet:CHANGE_ME@localhost:5432/fleet

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLEET_JWT_SECRET=
FLEET_ACCESS_TOKEN_TTL_MINUTES=30

FLEET_LOGIN_MAX_FAILED_ATTEMPTS=5
FLEET_LOGIN_LOCKOUT_MINUTES=15

FLEET_TELEMETRY_RETENTION_DAYS=180

FLEET_CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# Optional. Must be https.
FLEET_DEALER_WEBHOOK_URL=
FLEET_DEALER_WEBHOOK_SECRET=
